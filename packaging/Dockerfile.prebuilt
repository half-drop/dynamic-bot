FROM eclipse-temurin:17-jre

LABEL maintainer="dynamic-bot"
LABEL description="dynamic-bot - prebuilt runtime image"

ARG APP_UID=1000
ARG APP_GID=1000

ENV APP_UID=${APP_UID}
ENV APP_GID=${APP_GID}
ENV APP_USER=dynamicbot
ENV APP_RUNTIME_DIR=/app/.runtime
ENV LOG_DIR=/app/logs
ENV DYNAMIC_BOT_WEB_ADMIN_HOST=0.0.0.0
ENV TZ=Asia/Shanghai
ENV HOME=/app/.runtime/home
ENV XDG_CACHE_HOME=/app/.runtime/cache
ENV TMPDIR=/app/.runtime/tmp

RUN apt-get update && \
    DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends curl ca-certificates gosu tzdata libgl1 && \
    ln -snf /usr/share/zoneinfo/${TZ} /etc/localtime && \
    echo ${TZ} > /etc/timezone && \
    rm -rf /var/lib/apt/lists/*

RUN set -eux; \
    if ! getent group dynamicbot >/dev/null 2>&1; then groupadd --system dynamicbot; fi; \
    if ! id dynamicbot >/dev/null 2>&1; then useradd --system --gid dynamicbot --home-dir /app/.runtime/home --no-create-home --shell /usr/sbin/nologin dynamicbot; fi; \
    mkdir -p /app/.runtime/home /app/.runtime/cache /app/.runtime/tmp /app/data/images/source /app/data/images/draw /app/data/plugins /app/data/videos /app/data/login-qr /app/data/fonts /app/config /app/plugins /app/logs /app/defaults/plugins && \
    chown -R dynamicbot:dynamicbot /app

WORKDIR /app

COPY --chown=dynamicbot:dynamicbot dynamic-bot.jar /app/dynamic-bot.jar
COPY --chown=dynamicbot:dynamicbot plugins/catalog.json /app/defaults/plugins/catalog.json
COPY docker/entrypoint.sh /app/entrypoint.sh
RUN chmod +x /app/entrypoint.sh

EXPOSE 2233
ENV HEALTH_CHECK_PORT=2233
HEALTHCHECK --interval=30s --timeout=3s --start-period=40s --retries=3 \
    CMD curl -f http://localhost:${HEALTH_CHECK_PORT}/api/health || exit 1

ENV JAVA_OPTS="-Xms256m -Xmx1g -XX:+UseG1GC -XX:MaxGCPauseMillis=200"
ENTRYPOINT ["/app/entrypoint.sh"]
CMD ["sh", "-c", "exec java $JAVA_OPTS -jar /app/dynamic-bot.jar"]
